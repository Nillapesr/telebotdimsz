model Bot {
  id          String   @id @default(cuid())
  name        String
  token       String   @unique
  description String?  @default("Bot Telegram")
  status      String   @default("offline") // online | offline | error
  code        String   @default("module.exports = async (ctx) => { await ctx.reply('Halo! Aku bot Telegram.'); };")
  framework   String   @default("grammY")
  webhookUrl  String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
