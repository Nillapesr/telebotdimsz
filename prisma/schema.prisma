generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  bots      Bot[]
  createdAt DateTime @default(now())
}

model Bot {
  id          String   @id @default(cuid())
  name        String
  token       String   @unique
  description String?  @default("Bot Telegram")
  status      String   @default("offline")
  code        String   @default("module.exports = async (ctx) => { await ctx.reply('Halo!'); };")
  framework   String   @default("grammY")
  webhookUrl  String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
